# Personal Finance Advisor Bot - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Flask Secret Key for sessions and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database Configuration (SQLite by default, PostgreSQL for production)
# SQLite: sqlite:///finance.db
# PostgreSQL: postgresql://username:password@localhost:5432/finance_db
DATABASE_URL=sqlite:///finance.db

# Google Gemini AI API Key (Optional: Graceful fallback engine works without it)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Environment (development / production / testing)
FLASK_ENV=development
DEBUG=True
